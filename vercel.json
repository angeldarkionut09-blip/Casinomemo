{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/casinobyhacky/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/casinobyhacky",
      "destination": "/casinobyhacky/index.html"
    },
    {
      "source": "/casinobyhacky/",
      "destination": "/casinobyhacky/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/casinobyhacky",
      "permanent": false
    },
    {
      "source": "/CasinobyHacky",
      "destination": "/casinobyhacky",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/casinobyhacky(/?|/index.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/casinobyhacky/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
