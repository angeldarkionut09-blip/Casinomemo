{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/citely/api/:path*", "destination": "/api/:path*" },
    { "source": "/citely", "destination": "/citely/index.html" },
    { "source": "/citely/", "destination": "/citely/index.html" }
  ],
  "redirects": [{ "source": "/", "destination": "/citely", "permanent": false }],
  "headers": [
    {
      "source": "/citely(/?|/index.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/citely/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
